{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shaker-Chaos ResearchCase schema v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "origin": {
      "enum": [
        "DEMO",
        "REFERENCE"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "inputSequence": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "PourStarted"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "operationId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "ingredientId": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "type",
              "sequence",
              "atMs",
              "operationId",
              "ingredientId"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "PourTick"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "operationId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "ingredientId": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "requestedUnits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "sequence",
              "atMs",
              "operationId",
              "ingredientId",
              "requestedUnits"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "PourEnded"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "operationId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reason": {
                "enum": [
                  "completed",
                  "cancelled",
                  "limit",
                  "served",
                  "reset"
                ]
              }
            },
            "required": [
              "type",
              "sequence",
              "atMs",
              "operationId",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "ShakeStarted"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "operationId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "sequence",
              "atMs",
              "operationId"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "ShakeTick"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "operationId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "sequence",
              "atMs",
              "operationId",
              "durationMs"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "ShakeEnded"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "operationId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reason": {
                "enum": [
                  "completed",
                  "cancelled",
                  "limit",
                  "served",
                  "reset"
                ]
              }
            },
            "required": [
              "type",
              "sequence",
              "atMs",
              "operationId",
              "reason"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "IceAdded"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "requestedUnits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "sequence",
              "atMs",
              "requestedUnits"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "GarnishChanged"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "garnishId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "sequence",
              "atMs",
              "garnishId"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "Served"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "sequence",
              "atMs"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "Reset"
              },
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "atMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "sequence",
              "atMs"
            ]
          }
        ]
      }
    },
    "inputValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "UNVERIFIED",
            "VERIFIED"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "evidenceIds",
        "notes"
      ]
    },
    "expectedObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "reactionTier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reactionId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "exploded": {
          "type": "boolean"
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "capacityUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timingThresholdMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acceptedActions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "accepted": {
                "type": "boolean"
              }
            },
            "required": [
              "sequence",
              "accepted"
            ]
          }
        }
      },
      "required": [],
      "minProperties": 1
    },
    "observedReferenceResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "reactionTier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reactionId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "exploded": {
          "type": "boolean"
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "capacityUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timingThresholdMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acceptedActions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "accepted": {
                "type": "boolean"
              }
            },
            "required": [
              "sequence",
              "accepted"
            ]
          }
        }
      },
      "required": [],
      "minProperties": 1
    },
    "status": {
      "enum": [
        "VERIFIED",
        "STRONGLY_SUPPORTED",
        "UNVERIFIED"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "const": "reference-manual"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "referenceBuild": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "procedure": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "repetitions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "scope",
          "date",
          "source",
          "referenceBuild",
          "procedure",
          "repetitions"
        ]
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "origin",
    "id",
    "title",
    "purpose",
    "inputSequence",
    "inputValidation",
    "status",
    "confidence",
    "evidence",
    "notes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "const": "DEMO"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "UNVERIFIED"
          },
          "evidence": {
            "maxItems": 0
          },
          "inputValidation": {
            "properties": {
              "status": {
                "const": "UNVERIFIED"
              }
            }
          }
        },
        "not": {
          "required": [
            "observedReferenceResult"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "VERIFIED",
              "STRONGLY_SUPPORTED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "observedReferenceResult"
        ],
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "VERIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "inputValidation": {
            "properties": {
              "status": {
                "const": "VERIFIED"
              },
              "evidenceIds": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inputValidation": {
            "properties": {
              "status": {
                "const": "VERIFIED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "origin": {
            "const": "REFERENCE"
          },
          "inputValidation": {
            "properties": {
              "evidenceIds": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
