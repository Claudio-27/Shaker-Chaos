{
  "name": "shaker-chaos",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "build": "npm run typecheck && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "research:record": "node scripts/research.mjs record",
    "research:fixtures": "node scripts/research.mjs fixtures",
    "research:validate": "node scripts/research.mjs validate",
    "research:summary": "node scripts/research.mjs summary",
    "research:model": "node scripts/research.mjs model",
    "research:reference": "node research/reference-runner/server.mjs",
    "research:native:doctor": "node research/native-runner/cli.mjs doctor",
    "research:native:calibrate": "node research/native-runner/cli.mjs calibrate",
    "research:native:smoke": "node research/native-runner/cli.mjs smoke",
    "research:native:run": "node research/native-runner/cli.mjs run",
    "research:native:launch": "node research/native-runner/cli.mjs launch",
    "research:native:inspect": "node research/native-runner/cli.mjs inspect",
    "research:native:input": "node research/native-runner/cli.mjs input",
    "research:native:stop": "node research/native-runner/cli.mjs stop",
    "research:native:record": "node research/native-runner/record.mjs",
    "research:raw": "node scripts/research.mjs raw"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
